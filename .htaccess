# PHP overrides for image uploads
php_value upload_max_filesize 4M
php_value post_max_size 5M
php_value max_execution_time 60

# Deny direct access to includes and data directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^data/ - [F,L]
</IfModule>

# Block web access to log files (error_log can be written into any directory
# by PHP, and may contain server paths, DB user, and stack traces)
<FilesMatch "(^error_log$|\.log$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
